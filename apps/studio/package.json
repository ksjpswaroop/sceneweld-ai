{
  "name": "scenemeld-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write client server tests *.mjs *.json",
    "format:check": "prettier --check client server tests *.mjs *.json"
  },
  "dependencies": {
    "director-mcp": "file:vendor/director-mcp-0.2.0.tgz",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.0.0"
  },
  "files": [
    "dist",
    "server",
    "vendor",
    "README.md",
    "VERIFICATION.md",
    "LICENSE"
  ],
  "license": "MIT"
}
